<!-- Page header -->
<div class="mb-8">

  <!-- Title -->
  <h1 class="text-2xl text-center md:text-3xl text-foreground font-bold"><%= t("titulo_cuenta") %> ✨</h1>

</div>

<div class="bg-card shadow-lg rounded-sm mb-8">
  <div data-controller="tabs" data-tabs-active-tab-class="bg-primary/10" class="flex flex-col md:flex-row md:-mr-px">
    <div>

      <!-- Sidebar -->
      <%= render "sidebar" %>
    </div>

    <!-- Panel Account -->
    <%= render "account" %>

    <!-- Panel Fiscal Data -->
    <%= render "personal" %>

    <!-- Panel Address -->
    <%= render "address" %>

    <!-- Panel Preferencias -->
    <%= render "preferencias" %>

  </div>
</div>
