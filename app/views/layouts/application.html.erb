<!DOCTYPE html>
<html lang=<%= I18n.locale %> class="h-full bg-background">
  <head>
    <%= render 'shared/head' %>
  </head>
  <body 
    class="font-inter antialiased bg-background text-muted-foreground"
    data-controller="sidebar"
    data-action="click@window->sidebar#hide keydown.esc@window->sidebar#close">
    <script>
      (function () {
        let expanded = false;
        try {
          expanded = localStorage.getItem("sidebar-expanded") === "true";
        } catch (e) {
          // Sin almacenamiento, el sidebar empieza contraído.
        }
        document.body.classList.toggle("sidebar-expanded", expanded);
      })();
    </script>
    <div class="flash" id="flash">
      <%= render "shared/flash", position: "top-10 left-1/2" %>
    </div>
    <!-- Page wrapper -->
    <div class="flex h-screen overflow-hidden">
      <% if user_signed_in? %>
        <%= render 'shared/sidebar' %>
      <% end %>
      <!-- Content area -->
      <div class="relative flex flex-col flex-1 overflow-y-auto overflow-x-hidden">
        <% if user_signed_in? %>
          <%= render 'shared/navbar' %>
        <% end %>
        <main>
          <div class="px-4 sm:px-6 lg:px-8 py-8 w-full max-w-9xl mx-auto">
            <%= yield %>
            <%= render 'shared/modal' %>
          </div>
        </main>
      </div>
    </div>
  </body>
</html>
