<!-- Progress bar -->
<div class="px-4 pt-12 pb-8">
    <div class="max-w-md mx-auto w-full">
        <div class="relative">
            <div class="absolute left-0 top-1/2 -mt-px w-full h-0.5 bg-border" aria-hidden="true"></div>
            <ul class="relative flex justify-between w-full">
                <li>
                    <a class="flex items-center justify-center w-6 h-6 rounded-full text-xs font-semibold bg-primary text-primary-foreground" href="/after_register/freelance_or_company">1</a>
                </li>
                <li>
                    <a class="flex items-center justify-center w-6 h-6 rounded-full text-xs font-semibold bg-primary/10 text-primary-foreground" href="/after_register/set_name">2</a>
                </li>
                <li>
                    <a class="flex items-center justify-center w-6 h-6 rounded-full text-xs font-semibold bg-primary/10 text-primary-foreground" href="/after_register/set_address">3</a>
                </li>
            </ul>
        </div>
    </div>
</div>
<div class="max-w-md mx-auto">

    <h1 class="text-3xl text-foreground font-bold mb-6"><%= t("how_will_you_invoice?") %> ✨</h1>
                                
    <!-- Form -->
    <%= form_for(@user_profile, url: wizard_path, method: 'put' ) do |f| %>
        <div class="sm:flex space-y-3 sm:space-y-0 sm:space-x-4 mb-8">
            <% if f.object.errors.any? %>
                <div id="error_explanation" class="bg-danger-muted text-danger px-3 py-2 font-medium rounded-lg mt-3">
                    <h2><%= pluralize(f.object.errors.count, "error") %> prohibited this invoice from being saved:</h2>
                    <ul>
                        <% f.object.errors.each do |error| %>
                            <li><%= error.full_message %></li>
                        <% end %>
                    </ul>
                </div>
            <% end %>
            <%= f.hidden_field :user_id, value: @user.id %>
            <label class="flex-1 relative block cursor-pointer">
                <%= f.radio_button :is_freelance, "true", class: "peer sr-only", checked: true %>
                <div class="h-full text-center bg-card px-4 py-6 rounded border border-border hover:border-ring shadow-sm duration-150 ease-in-out">
                    <svg class="inline-flex w-10 h-10 shrink-0 fill-current mb-2" viewBox="0 0 40 40">
                        <circle class="text-primary/30" cx="20" cy="20" r="20" />
                        <path class="text-primary" d="m26.371 23.749-3.742-1.5a1 1 0 0 1-.629-.926v-.878A3.982 3.982 0 0 0 24 17v-1.828A4.087 4.087 0 0 0 20 11a4.087 4.087 0 0 0-4 4.172V17a3.982 3.982 0 0 0 2 3.445v.878a1 1 0 0 1-.629.928l-3.742 1.5a1 1 0 0 0-.629.926V27a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-2.323a1 1 0 0 0-.629-.928Z" />
                    </svg>
                    <div class="font-medium text-foreground mb-1"><%= t("self_employed") %></div>
                    <div class="text-sm"><%= t("self_employed_text") %></div>
                </div>
                <div class="absolute inset-0 border-2 border-transparent peer-checked:border-ring rounded pointer-events-none" aria-hidden="true"></div>
            </label>
            <label class="flex-1 relative block cursor-pointer">
                <%= f.radio_button :is_freelance, "false", class: "peer sr-only" %>
                <div class="h-full text-center bg-card px-4 py-6 rounded border border-border hover:border-ring shadow-sm duration-150 ease-in-out">
                    <svg class="inline-flex w-10 h-10 shrink-0 fill-current mb-2" viewBox="0 0 40 40">
                        <circle class="text-primary/30" cx="20" cy="20" r="20" />
                        <path class="text-primary" d="m26.371 23.749-3.742-1.5a1 1 0 0 1-.629-.926v-.878A3.982 3.982 0 0 0 24 17v-1.828A4.087 4.087 0 0 0 20 11a4.087 4.087 0 0 0-4 4.172V17a3.982 3.982 0 0 0 2 3.445v.878a1 1 0 0 1-.629.928l-3.742 1.5a1 1 0 0 0-.629.926V27a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-2.323a1 1 0 0 0-.629-.928Z" />
                        <circle class="text-primary/30" cx="20" cy="20" r="20" />
                        <path class="text-primary/70" d="m30.377 22.749-3.709-1.5a1 1 0 0 1-.623-.926v-.878A3.989 3.989 0 0 0 28.027 16v-1.828c.047-2.257-1.728-4.124-3.964-4.172-2.236.048-4.011 1.915-3.964 4.172V16a3.989 3.989 0 0 0 1.982 3.445v.878a1 1 0 0 1-.623.928c-.906.266-1.626.557-2.159.872-.533.315-1.3 1.272-2.299 2.872 1.131.453 6.075-.546 6.072.682V28a2.99 2.99 0 0 1-.182 1h7.119A.996.996 0 0 0 31 28v-4.323a1 1 0 0 0-.623-.928Z" />
                        <path class="text-primary" d="m22.371 24.749-3.742-1.5a1 1 0 0 1-.629-.926v-.878A3.982 3.982 0 0 0 20 18v-1.828A4.087 4.087 0 0 0 16 12a4.087 4.087 0 0 0-4 4.172V18a3.982 3.982 0 0 0 2 3.445v.878a1 1 0 0 1-.629.928l-3.742 1.5a1 1 0 0 0-.629.926V28a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-2.323a1 1 0 0 0-.629-.928Z" />
                    </svg>
                    <div class="font-medium text-foreground mb-1"><%= t("company") %></div>
                    <div class="text-sm"><%= t("company_text") %></div>
                </div>
                <div class="absolute inset-0 border-2 border-transparent peer-checked:border-ring rounded pointer-events-none" aria-hidden="true"></div>
            </label>
        </div>
        <div class="flex items-center justify-between space-x-6 mb-8">
            <div>
                <div class="font-medium text-foreground text-sm mb-1">💸 Lorem ipsum is place text commonly?</div>
                <div class="text-xs">Lorem ipsum is placeholder text commonly used in the graphic, print, and publishing industries for previewing layouts.</div>
            </div>
        </div>
        <div class="flex items-center justify-between">
            <%= f.button class: 'btn bg-primary-hover hover:bg-primary-active text-primary-foreground ml-auto cursor-pointer' do %>
                <%= t("next") %> <%= heroicon "arrow-right", variant: :mini %>
            <% end %>
        </div>
    <% end %>
</div>
