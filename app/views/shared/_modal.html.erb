<div class="modal opacity-0 pointer-events-none z-50" tabindex="-1" 
      data-controller="modal" 
      data-action="turbo:frame-load->modal#open turbo:submit-end->modal#close keydown.esc@window->modal#close click->modal#closeOnClickOutside"
  data-modal-target="modal"
  >
  <div class="modal-content" data-modal-target="content">
    <%= turbo_frame_tag "modal" %>
  </div>
</div>