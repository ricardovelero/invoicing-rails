    <div class="flex items-center justify-center">
        <span>&copy; <%= Date.today.year %> Fact</span>
    </div>
    <div class="flex flex-wrap justify-center">
        <%= link_to "Terms", terms_path, class: "text-muted-foreground hover:text-foreground no-underline block px-4 lg:my-0 my-2" %>
        <%= link_to "Privacy", privacy_path, class: "text-muted-foreground hover:text-foreground no-underline block px-4 lg:my-0 my-2" %>
    </div>
  </div>
</footer>
