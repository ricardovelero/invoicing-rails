<title>Facturación iO</title>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
<%= csrf_meta_tags %>
<%= csp_meta_tag %>
<script>
  // Apply the saved theme (or the OS preference) before first paint to
  // avoid a flash of the wrong theme. Must run before the CSS loads and
  // stays in sync with the `theme` Stimulus controller.
  (function () {
    var stored;
    try {
      stored = localStorage.getItem("theme");
    } catch (e) {
      stored = null;
    }
    var dark = stored === "dark" ||
      (stored !== "light" && window.matchMedia("(prefers-color-scheme: dark)").matches);
    if (dark) document.documentElement.classList.add("dark");
  })();
</script>
<%= stylesheet_link_tag "tailwind", "inter-font", "data-turbo-track": "reload" %>
<%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
<%= javascript_importmap_tags %>
